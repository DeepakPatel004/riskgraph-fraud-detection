DATABASE_URL=sqlite:///./riskgraph.db
APP_NAME=RiskGraph API

# Optional Neptune settings; nothing connects unless explicitly constructed.
# NEPTUNE_ENDPOINT=<hostname-only>
# NEPTUNE_PORT=8182
# NEPTUNE_TIMEOUT=10
# NEPTUNE_IAM_AUTH_ENABLED=true
# NEPTUNE_REGION=<cluster-region>

# Graph worker is disabled unless explicitly started with an adapter.
# GRAPH_SYNC_ADAPTER=disabled
# GRAPH_SYNC_INITIAL_DELAY=5
# GRAPH_SYNC_BACKOFF_FACTOR=2
# GRAPH_SYNC_MAX_DELAY=300
# GRAPH_SYNC_MAX_ATTEMPTS=5
# GRAPH_SYNC_LEASE_SECONDS=300
# GRAPH_SYNC_POLL_INTERVAL=1
# GRAPH_SYNC_BATCH_SIZE=20

# Scoring is disabled by default; see docs/scoring-api.md before opting in.
# Only one API worker on one host with a local file-backed SQLite database.
# FRAUD_SCORING_ENABLED=false
# SCORING_API_WORKERS=1
# GRAPH_POPULATION_NAME=<unique-dedicated-graph-epoch>
# GRAPH_POPULATION_VERIFIED=false
# FRAUD_MODEL_ARTIFACT_DIR=<trusted-local-bundle-directory>
