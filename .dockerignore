!backend/
!backend/Dockerfile
!backend/requirements.txt
!backend/requirements-ml.txt
!backend/app/
!backend/app/**
!backend/scripts/
!backend/scripts/**
**/__pycache__/
**/*.py[cod]
**/.env*
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
